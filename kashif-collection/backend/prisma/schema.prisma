// Kashif Collection — PostgreSQL schema
// Conventions:
//  * All monetary values are stored as INTEGER PAISE (₹1 = 100 paise) to avoid floating point errors.
//  * Soft delete (deletedAt) is used for entities referenced by historical orders.
//  * Order rows snapshot product/price/address data so history never changes when catalogue data changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum InventoryTransactionType {
  RESTOCK
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN
  CANCEL_RESTOCK
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationType {
  ORDER
  PAYMENT
  RETURN
  REFUND
  INVENTORY
  ACCOUNT
  SYSTEM
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  /// Incremented on password change / forced logout; embedded in session JWT to invalidate old sessions.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses           Address[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  couponUsages        CouponUsage[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  returns             Return[]
  inventoryActions    InventoryTransaction[]
  statusChanges       OrderStatusHistory[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  house     String
  street    String
  area      String?
  landmark  String?
  city      String
  state     String   @default("Uttar Pradesh")
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────── Catalogue ───────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subcategories Subcategory[]
  products      Product[]
  coupons       CouponCategory[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id               String    @id @default(cuid())
  sku              String    @unique
  name             String
  slug             String    @unique
  description      String
  shortDescription String?
  categoryId       String
  subcategoryId    String?
  brand            String    @default("Kashif Collection")
  /// Maximum retail price in paise (inclusive of taxes)
  mrp              Int
  /// Selling price in paise
  price            Int
  /// Derived from mrp/price by the product service; stored for sorting & filtering.
  discountPercent  Int       @default(0)
  /// GST rate in percent, e.g. 18.00
  gstRate          Decimal   @default(18) @db.Decimal(5, 2)
  hsnCode          String?
  weightGrams      Int       @default(100)
  tags             String[]  @default([])
  ingredients      String?
  howToUse         String?
  isFeatured       Boolean   @default(false)
  isBestSeller     Boolean   @default(false)
  isNewArrival     Boolean   @default(false)
  isActive         Boolean   @default(true)
  ratingAvg        Float     @default(0)
  ratingCount      Int       @default(0)
  soldCount        Int       @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  coupons        CouponProduct[]

  @@index([categoryId, isActive])
  @@index([subcategoryId])
  @@index([brand])
  @@index([price])
  @@index([discountPercent])
  @@index([ratingAvg])
  @@index([soldCount])
  @@index([createdAt])
  @@index([isActive, deletedAt])
  @@index([tags], type: Gin)
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  /// Cloudinary public_id / S3 object key (used for deletion)
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

/// Every product has at least one variant ("Default" for products without options).
/// Inventory, cart and order lines always reference a variant.
model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  sku       String    @unique
  name      String
  color     String?
  colorHex  String?
  size      String?
  /// Optional price overrides in paise; fall back to product price/mrp when null.
  price     Int?
  mrp       Int?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory     Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([color])
  @@index([size])
  @@map("product_variants")
}

/// Invariant (enforced by DB CHECK constraints): totalStock = reservedStock + availableStock, all >= 0.
model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  totalStock        Int      @default(0)
  reservedStock     Int      @default(0)
  availableStock    Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([availableStock])
  @@map("inventory")
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  inventoryId   String
  type          InventoryTransactionType
  /// Signed change applied to totalStock (RESTOCK/ADJUSTMENT/SALE/RETURN) or reservedStock (RESERVE/RELEASE)
  quantity      Int
  totalAfter    Int
  reservedAfter Int
  reason        String?
  orderId       String?
  performedById String?
  createdAt     DateTime                 @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedBy User?     @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([orderId])
  @@map("inventory_transactions")
}

// ──────────────────────── Cart & Wishlist ────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ──────────────────────────── Orders ─────────────────────────────

/// Per-year counter used to produce human friendly order numbers: KC-2026-000001
model OrderCounter {
  year      Int @id
  lastValue Int @default(0)

  @@map("order_counters")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Amounts (paise) — computed server-side only
  mrpTotal        Int
  subtotal        Int
  productDiscount Int
  couponDiscount  Int     @default(0)
  taxTotal        Int
  /// true when item prices already include GST (tax is shown as a breakdown, not added)
  taxInclusive    Boolean @default(true)
  cgst            Int     @default(0)
  sgst            Int     @default(0)
  igst            Int     @default(0)
  shippingFee     Int     @default(0)
  codFee          Int     @default(0)
  grandTotal      Int
  currency        String  @default("INR")

  couponId   String?
  couponCode String?

  // Shipping address snapshot
  shipName     String
  shipPhone    String
  shipHouse    String
  shipStreet   String
  shipArea     String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String
  shipCountry  String @default("India")

  shippingProvider      String    @default("standard")
  trackingNumber        String?
  trackingUrl           String?
  estimatedDeliveryDate DateTime?

  /// Online orders hold stock only until this time unless paid.
  reservationExpiresAt DateTime?
  /// true once reserved stock has been converted into a sale (deducted from total stock)
  stockCommitted       Boolean   @default(false)
  /// true while stock is reserved (not yet committed/released)
  stockReserved        Boolean   @default(false)
  customerNote         String?
  cancelReason         String?
  idempotencyKey       String?

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon        Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  couponUsage   CouponUsage?
  returns       Return[]
  refunds       Refund[]
  inventoryTx   InventoryTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String
  productSlug String
  variantName String
  sku         String
  imageUrl    String?
  quantity    Int
  mrp         Int
  unitPrice   Int
  /// unitPrice * quantity
  lineTotal   Int
  /// Share of the order coupon discount allocated to this line
  couponShare Int     @default(0)
  gstRate     Decimal @db.Decimal(5, 2)
  taxAmount   Int
  hsnCode     String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────────────── Payments ────────────────────────────

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  gateway          PaymentMethod
  amount           Int
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  /// Razorpay order id / Stripe PaymentIntent id
  gatewayOrderId   String?
  /// Razorpay payment id / Stripe charge id — the gateway transaction id
  gatewayPaymentId String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([gateway, gatewayOrderId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Stores processed webhook event ids so duplicate deliveries are ignored.
model WebhookEvent {
  id          String        @id @default(cuid())
  gateway     PaymentMethod
  eventId     String
  type        String
  processedAt DateTime      @default(now())

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

// ──────────────────────────── Coupons ────────────────────────────

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  type          CouponType
  /// Percentage (1-100) for PERCENTAGE, paise for FIXED
  value         Int
  minCartValue  Int        @default(0)
  maxDiscount   Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int        @default(0)
  perUserLimit  Int        @default(1)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  categories CouponCategory[]
  products   CouponProduct[]
  usages     CouponUsage[]
  orders     Order[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  discount  Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_usages")
}

// ─────────────────────────── Reviews ─────────────────────────────

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String
  orderItemId        String?      @unique
  rating             Int
  title              String?
  body               String
  imageUrl           String?
  imagePublicId      String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// ─────────────────────── Returns & Refunds ───────────────────────

model Return {
  id         String       @id @default(cuid())
  orderId    String
  userId     String
  reason     String
  details    String?
  status     ReturnStatus @default(REQUESTED)
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String?
  returnId        String?
  amount          Int
  status          RefundStatus @default(PENDING)
  reason          String?
  gatewayRefundId String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  return  Return?  @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id        String           @id @default(cuid())
  /// null = admin/broadcast notification
  userId    String?
  audience  Role             @default(CUSTOMER)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([audience, isRead])
  @@map("notifications")
}

// ──────────────────────── Store settings ─────────────────────────

/// Singleton row (id = 1) holding admin-configurable business rules.
model StoreSettings {
  id                       Int      @id @default(1)
  codEnabled               Boolean  @default(true)
  codMinOrderValue         Int      @default(0)
  codMaxOrderValue         Int      @default(1000000)
  codFee                   Int      @default(4900)
  flatShippingFee          Int      @default(7900)
  freeShippingThreshold    Int      @default(99900)
  pricesIncludeTax         Boolean  @default(true)
  defaultGstRate           Decimal  @default(18) @db.Decimal(5, 2)
  /// State of the seller's GST registration — decides CGST+SGST vs IGST
  businessState            String   @default("Uttar Pradesh")
  orderReservationMinutes  Int      @default(30)
  returnWindowDays         Int      @default(7)
  defaultLowStockThreshold Int      @default(5)
  updatedAt                DateTime @updatedAt

  @@map("store_settings")
}

/// Optional pincode-level serviceability overrides. When a pincode has no row,
/// the shipping service falls back to zone rules.
model ServiceablePincode {
  pincode       String  @id
  city          String?
  state         String?
  isServiceable Boolean @default(true)
  codAvailable  Boolean @default(true)
  deliveryDays  Int     @default(5)

  @@map("serviceable_pincodes")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
  @@map("contact_messages")
}
