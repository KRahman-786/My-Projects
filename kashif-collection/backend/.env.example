# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://kashif:kashif_dev@localhost:5432/kashif_collection?schema=public
# Only needed for `prisma migrate dev` when your DB user cannot create databases
SHADOW_DATABASE_URL=postgresql://kashif:kashif_dev@localhost:5432/kashif_shadow
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# ─── URLs / networking ───────────────────────────────────────────────────
# Storefront origin (CORS, password-reset links)
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=
# Public URL of this API (used for locally stored dev uploads)
API_PUBLIC_URL=http://localhost:4000
# Number of reverse proxies in front of the API (Express "trust proxy")
TRUST_PROXY=1
# Shared secret with the Next.js /api proxy so the forwarded visitor IP is trusted (must match the frontend)
PROXY_SHARED_SECRET=
# Optional cookie domain, e.g. .kashifcollection.in (only when the API is called cross-subdomain)
COOKIE_DOMAIN=

# ─── Razorpay (use TEST keys: rzp_test_...) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → secret for https://<api>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ─── Stripe (use TEST keys: sk_test_..., pk_test_...) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# `stripe listen --forward-to localhost:4000/api/payments/stripe/webhook` prints a whsec_... secret
STRIPE_WEBHOOK_SECRET=

# ─── Cloudinary image storage (required in production) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kashif-collection

# ─── Email (optional; without SMTP, emails are written to the server log) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kashif Collection <no-reply@kashifcollection.in>"
ADMIN_NOTIFICATION_EMAIL=

# ─── Business / misc ─────────────────────────────────────────────────────
# Printed on invoices once registered
BUSINESS_GSTIN=
# Background job that expires unpaid orders (set false if you run `npm run jobs:expire-orders` via cron instead)
ENABLE_JOBS=true
# Shipping provider key registered in src/services/shipping/shipping.service.ts
SHIPPING_PROVIDER=standard
