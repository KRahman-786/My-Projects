# Public site URL (used for canonical URLs, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base used by the browser. Default "/api" goes through the Next.js proxy (recommended: first-party cookies).
NEXT_PUBLIC_API_URL=/api
# Where the Next.js server reaches the backend (server components + the /api proxy)
API_INTERNAL_URL=http://localhost:4000
# Stripe publishable key is also served by the API (/api/payments/config); this is an optional override.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
